@{
    ViewData["Title"] = "購物車";
}
<div class="container py-4" id="cartApp" v-cloak>
    <h2 class="mb-3">購物車</h2>

    <div class="mb-3 d-flex gap-2">
        <button class="btn btn-outline-secondary" v-on:click="reload">重新整理</button>
        <button class="btn btn-outline-primary" v-on:click="addDemo">加一個範例商品</button>
    </div>

    <div v-if="items.length===0" class="alert alert-info">購物車是空的</div>

    <div v-else class="table-responsive">
        <table class="table align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width:36px"><input type="checkbox" v-model="checkAll" v-on:change="toggleAll"></th>
                    <th>商品</th>
                    <th class="text-end">單價</th>
                    <th class="text-center">數量</th>
                    <th class="text-end">小計</th>
                    <th style="width:100px"></th>
                </tr>
            </thead>
            <tbody>
                <tr v-for="it in items" :key="it.productId">
                    <td><input type="checkbox" v-model="selected" :value="it.productId"></td>
                    <td class="d-flex align-items-center gap-2">
                        <img :src="it.imageUrl" alt="" style="width:60px;height:60px;object-fit:contain;background:#f8f9fa" />
                        <div>{{ it.productName }}</div>
                    </td>
                    <td class="text-end">NT$ {{ it.price.toLocaleString() }}</td>
                    <td class="text-center">
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-secondary" v-on:click="dec(it)">−</button>
                            <input type="number" class="form-control form-control-sm w-auto text-center"
                                   v-model.number="it.qty" min="1" v-on:change="update(it)">
                            <button class="btn btn-outline-secondary" v-on:click="inc(it)">＋</button>
                        </div>
                    </td>
                    <td class="text-end">NT$ {{ (it.price * it.qty).toLocaleString() }}</td>
                    <td>
                        <button class="btn btn-sm btn-outline-danger" v-on:click="remove(it.productId)">移除</button>
                    </td>
                </tr>
            </tbody>

            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">總計</th>
                    <th class="text-end">NT$ {{ total.toLocaleString() }}</th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="d-flex flex-wrap gap-2 align-items-center my-3">
        <div class="input-group w-auto">
            <span class="input-group-text">我的優惠券</span>
            <select class="form-select" v-model="selectedCouponCode">
                <option value="" disabled>請選擇可用的優惠券</option>
                <option v-for="c in coupons" :key="c.couponId" :value="c.couponCode">
                    {{ c.name || ('優惠券#' + c.couponId) }}（代碼: {{ c.couponCode }}）
                </option>
            </select>
            <button class="btn btn-outline-primary" v-on:click="applySelectedCoupon" :disabled="!selectedCouponCode">套用</button>
            <button class="btn btn-outline-secondary" v-on:click="clearCoupon">清除</button>
        </div>

        <button class="btn btn-outline-danger ms-auto" :disabled="selected.length===0" v-on:click="batchRemove">刪除選取</button>
        <span class="text-success ms-2" v-if="discountHint">{{ discountHint }}</span>
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary" v-on:click="clearCart" :disabled="items.length===0">清空</button>

        <!-- 只把勾選的商品送去模擬付款 -->
        <form id="payCreditForm" method="post" action="/CustomersArea/Payment/CheckoutCredit">
            <!-- 一定要在 form 裡面產生真正的 input，template 有時被瀏覽器忽略 -->
            <div style="display:none">
                <input v-for="pid in selected" :key="'sel-'+pid" type="hidden"  name="productIds" :value="pid" />
            </div>
            <div class="d-flex gap-2">
                <!-- submit 沒問題；但禁用條件要確認有勾選 -->
                <button type="submit" class="btn btn-primary" :disabled="items.length===0 || selected.length===0">信用卡付款</button>
                <button type="button" class="btn btn-outline-primary" :disabled="items.length===0 || selected.length===0" v-on:click="payByTransfer">轉帳匯款</button>
            </div>
        </form>
    </div>

    <footer class="card shadow-sm sticky-bottom p-3 bg-white border">
        <div class="d-flex justify-content-between align-items-center">
            <div class="fs-6 text-muted" v-if="discount>0">
                折扣：−NT$ {{ discount.toLocaleString() }}
            </div>
            <div class="fs-5">
                合計：<strong>NT$ {{ finalTotal.toLocaleString() }}</strong>
            </div>
        </div>
    </footer>

</div>
<script>console.log('Scripts section loaded ✅');</script>
@section Scripts {
    <style>
        [v-cloak] {
            display: none
        }</style>
    <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios@1/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        async function demo(){
          await Swal.fire({
            icon: 'success',
            title: '操作成功',
            text: '這是 SweetAlert 測試訊息',
            timer: 2000,
            showConfirmButton: false,
            timerProgressBar: true
          });
        }
    </script>
    <script>
        (() => {
            const { createApp, ref, onMounted, computed } = Vue;

            createApp({
              setup(){
                const customerId = ref(0); // 先用輸入測試，未接登入前暫用
                const items = ref([]);
                const total = ref(0);
                const couponCode = ref('');
                const discountHint = ref('');
                const selected = ref([]);
                const checkAll = ref(false);
                const selectedCouponCode = ref('');
                const coupons = ref([]);
                const discount = computed(() => {
                  if (!selectedCouponCode.value) return 0;

                  // 找到被選的券（API 回來屬性: { couponId, code, discountType, discountValue, ... }）
                  const c = coupons.value.find(x => x.code === selectedCouponCode.value);
                  if (!c) return 0;

                  // discountType: 1=折數(百分比 off), 2=固定金額
                  if (c.discountType === 1) {
                    // 10 表示 10% OFF
                    const percent = Number(c.discountValue || 0) / 100;
                    return Math.floor((total.value || 0) * percent);
                  }
                  if (c.discountType === 2) {
                    return Math.min(c.discountValue, total.value || 0);
                  }
                  return 0;
                });

                const finalTotal = computed(() => Math.max(0, (total.value || 0) - discount.value));

                function toDate(v){
                  if(!v) return '';
                  const d = new Date(v);
                  return isNaN(d) ? '' : d.toLocaleDateString('zh-TW');
                }
                async function applySelectedCoupon(){
                  if(!selectedCouponCode.value) return;
                  await Swal.fire({
                    icon: 'success',
                    title: '已套用優惠券',
                    text: '結帳金額已依優惠券即時更新',
                    timer: 1500,
                    showConfirmButton: false
                    });

                    await axios.post('/CustomersArea/Cart/apply-coupon',
                    new URLSearchParams({ code: selectedCouponCode.value })
                  );
                }
                async function loadCoupons(){
                  try {
                    const res = await axios.get('/CustomersArea/Coupons/api');
                    const raw = Array.isArray(res.data) ? res.data : [];

                    coupons.value = raw.map(c => ({
                      couponId: c.couponId ?? c.CouponID ?? 0,
                      couponCode: c.couponCode ?? c.CouponCode ?? '',   // ← 加這個
                      disCountCode: c.disCountCode ?? c.DisCountCode ?? '',
                      name: c.name ?? c.couponDesc ?? c.CouponDesc ?? '',
                      discountType: Number(c.discountType ?? c.DiscountType ?? 0),
                      discountValue: Number(c.discountValue ?? c.DiscountValue ?? 0),
                      expireAt: c.expireAt ?? c.endTime ?? c.EndTime ?? null
                    }));
                    } catch (err) {
                    console.error('載入優惠券失敗', err);
                    coupons.value = [];
                    }
                }

                async function addDemo(){
                  try{
                    const fp = await axios.get('/CustomersArea/Cart/first-product-id');
                    const pid = fp.data?.productId;
                    if (!pid) { alert('找不到任何商品'); return; }

                    await axios.post('/CustomersArea/Cart/add',
                      new URLSearchParams({ productId: pid, qty: 1 })
                    );
                    await reload();
                  }catch(err){
                    console.error(err);
                    alert('加入範例商品失敗：' + (err?.response?.status || ''));
                  }
                }

                async function payByTransfer(){
                  try {
                    // 1) 確認一下是否真的要用轉帳
                    const confirm = await Swal.fire({
                      icon: 'question',
                      title: '確認使用轉帳付款？',
                      text: '系統會寄出匯款帳號到你的信箱，訂單狀態為「未付款」，待後台對帳後改為「已付款」。',
                      showCancelButton: true,
                      confirmButtonText: '是的，寄出匯款資訊',
                      cancelButtonText: '再想一下'
                    });
                    if (!confirm.isConfirmed) return;

                    // 2) 先在後端建立未付款訂單（若你需要；你現有的 Cart/checkout 若已做，可保留）
                    await axios.post('/CustomersArea/Cart/checkout'); 

                    // 3) 寄出匯款資訊（後端會依登入者 Email 寄出）
                    await axios.post('/CustomersArea/Payment/Transfer');

                    // 4) 成功提示
                    await Swal.fire({
                      icon: 'success',
                      title: '已寄出匯款資訊',
                      text: '請至信箱查看匯款帳號，並於期限內完成轉帳。',
                      timer: 2200,
                      showConfirmButton: false,
                      timerProgressBar: true
                    });

                    // 5) 導回「我的訂單」
                    window.location.href = '/CustomersArea/Orders';
                  } catch (e) {
                    const msg = e?.response?.data?.error || e?.response?.data || '請稍後再試';
                    await Swal.fire({
                      icon: 'error',
                      title: '操作失敗',
                      text: msg
                    });
                  }
                }

                async function checkout(){
                  try{
                    const res = await axios.post('/CustomersArea/Cart/checkout', new URLSearchParams({
                      customerId: customerId.value   // 若你已經改成從登入取，就移除此欄位
                    }));
                    const orderIds = res.data?.orderIds || [];
                    if(orderIds.length === 0){
                      alert('已建立訂單，但未取得訂單編號');
                      return;
                    }

                    // 方式 1：直接建立 form 送到 Payment/Create（建議）
                    const form = document.createElement('form');
                    form.method = 'POST';
                    form.action = '/CustomersArea/Payment/Create';

                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'orderId';
                    input.value = orderIds[0]; // 只拿第一筆去付款
                    form.appendChild(input);

                    document.body.appendChild(form);
                    form.submit();

                    // 方式 2：若你還是想先回到「我的訂單」頁，就改成下面這行
                    // window.location.href = '/CustomersArea/Orders';
                  }catch(e){
                    console.error(e);
                    alert('結帳失敗：' + (e.response?.data?.error || ''));
                  }
                }

                async function reload(){
                  const { data } = await axios.get('/CustomersArea/Cart/api');
                  items.value = data.items || [];
                  total.value = data.total || 0;
                  // 回填折扣資訊（若後端有保存在 Session）
                  couponCode.value = data.coupon?.code || '';
                  discountHint.value = data.coupon?.hint || '';
                }
                function inc(it){ it.qty++; update(it); }
                function dec(it){ it.qty = Math.max(1, (it.qty || 1)-1); update(it); }

                async function update(it){
                  await axios.post('/CustomersArea/Cart/update', new URLSearchParams({
                    productId: it.productId, qty: it.qty
                  }));
                  await reload();
                }

                async function remove(productId){
                  await axios.post('/CustomersArea/Cart/remove', new URLSearchParams({ productId }));
                  await reload();
                }

                function toggleAll(){
                  selected.value = checkAll.value ? items.value.map(i=>i.productId) : [];
                }

                async function batchRemove(){
                  await axios.post('/CustomersArea/Cart/batch-remove', selected.value);
                  selected.value = [];
                  checkAll.value = false;
                  await reload();
                }

                async function applyCouponById(){
                  try{
                    await axios.post('/CustomersArea/Cart/apply-coupon', new URLSearchParams({
                      code: selectedCouponId.value  // 如果你改成傳 couponId，就和後端一致
                    }));
                    await Swal.fire({ icon:'success', title:'已套用折價券', timer:1600, showConfirmButton:false });
                    await reload();
                  }catch(e){
                    const msg = e?.response?.data?.error || '套用失敗';
                    await Swal.fire({ icon:'error', title:'失敗', text:msg });
                  }
                }
                async function clearCoupon(){
                  try{
                    await axios.post('/CustomersArea/Cart/clear-coupon');
                  }finally{
                    couponCode.value = '';
                    selectedCouponCode.value = '';
                    discountHint.value = '';
                    await reload();
                  }
                }
                async function clearCart(){
                  try{
                    await axios.post('/CustomersArea/Cart/clear');
                    await reload();
                  }catch(e){
                    console.error(e);
                    alert('清空失敗');
                  }
                }                

                onMounted(async () => {
                  await reload();
                  await loadCoupons();
                });

                return {
                  items, total, couponCode, discountHint,
                  selected, checkAll, toggleAll, batchRemove,
                  inc, dec, update, remove,applyCouponById,
                  clearCoupon,checkout,finalTotal,addDemo,customerId,
                  payByTransfer,loadCoupons,clearCart,coupons
                  ,applySelectedCoupon,toDate,selectedCouponCode
                };
              }
            }).mount('#cartApp');
        })();
    </script>
}
