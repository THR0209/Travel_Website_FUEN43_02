                                            <div class="text-center text-muted py-3">目前沒有通知</div>
                                        </div>
                                        <div class="p-2 text-center border-top" style="cursor:pointer"
                                             onclick="window.location.href='/CustomersArea/Notifications/Index'">
                                            <span class="text-decoration-none small text-primary">查看所有通知</span>
                                        </div>
                                    </div>
                                </li>
                                <li class="nav-item me-1">
                                    <a href="/CustomersArea/Cart" class="nav-link">
                                        <span class="link-text"><i class="fa-solid fa-cart-shopping me-1"></i>購物車</span><span class="badge bg-danger" id="cart-count">0</span>
                                    </a>
                                </li>
                                <li class="nav-item dropdown">
                                    <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                                        <span class="link-text">
                                            <i class="fa-solid fa-user me-1"></i>
                                            @if (isCustomerLoggedIn)
                                            {
                                                @customerName
                                                @if (!string.IsNullOrEmpty(customerLevelName))
