            </div>
        </div>
    </div>
    <!-- ***** Preloader End ***** -->
    <!-- 狀態提示：訪客/會員 -->
    @* 顯示目前登入狀態，方便自我測試與 UX提升 *@
    @* @if (isCustomerLoggedIn)
    {
