@model Cat_Paw_Footprint.Areas.CustomersArea.ViewModel.ProductDetailVM
@{
    ViewData["Title"] = Model.ProductName;
    var minDate = (Model.ReleaseDate?.Date > DateTime.Today ? Model.ReleaseDate.Value.Date : DateTime.Today);
    var maxDate = Model.RemovalDate?.Date;
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
    <style>
        .page-wrap {
            margin-top: 18px
        }

        .layout {
            display: grid;
            grid-template-columns: minmax(0,1fr) 360px;
            gap: 24px
        }
        @@media (max-width: 992px) {
            .layout

        {
            grid-template-columns: 1fr
        }

        }

        /* 主要標題與可讀性強化 */
        .title {
            font-size: 1.9rem;
            font-weight: 900;
            letter-spacing: .5px
        }

        .meta {
            color: #6b7d90
        }

        .badge-cat {
            background: #f2fbfe;
            border: 1px solid #d7eef6
        }

        /* 區塊標題與卡片 */
        .sec-title {
            position: relative;
            display: inline-block;
            font-weight: 900;
            margin-bottom: .9rem;
            font-size: 1.25rem
        }

            .sec-title:before {
                content: "";
                position: absolute;
                left: 0;
                right: 0;
                bottom: -8px;
                height: 12px;
                background: linear-gradient(90deg,#dff6fa,#fff);
                z-index: -1;
                border-radius: 6px
            }

        .day-title {
            font-weight: 900;
            color: #22B3C1;
            font-size: 1.15rem;
            margin: .1rem 0 .6rem
        }

        .card-soft {
            border: 1px solid #eef3f8;
            border-radius: 14px;
            padding: 16px;
            background: #fff;
            box-shadow: 0 2px 10px rgba(0,0,0,.04)
        }

            .ck-content, .card-soft p {
                font-size: 1.02rem;
                line-height: 1.9
            }

        /* 時間軸 */
        .timeline {
            position: relative;
            margin: 1rem 0 0 1rem;
            border-left: 3px solid #e8eef6
        }

            .timeline .node {
                width: 12px;
                height: 12px;
                background: #22B3C1;
                border-radius: 50%;
                position: absolute;
                left: -7.5px;
                top: .55rem
            }

        .day-block {
            position: relative;
            padding-left: 1rem;
            margin-bottom: 1rem
        }

        /* 圖文並列（桌機兩欄、手機單欄） */
        .spot-row {
            display: grid;
            grid-template-columns: 1fr 260px;
            gap: 14px;
            align-items: start;
            margin: .75rem 0
        }
        @@media (max-width: 768px) {
            .spot-row

        {
            grid-template-columns: 1fr
        }

        }

        .spot-thumb {
            width: 100%;
            border-radius: 12px;
            overflow: hidden;
            background: #f7fafb;
            border: 1px solid #e9eef3;
            cursor: pointer
        }

            .spot-thumb img {
                display: block;
                width: 100%;
                height: 200px;
                object-fit: cover
            }
        @@media (max-width: 768px) {
            .spot-thumb img

        {
            height: 180px
        }

        }

        /* 小籤樣式 */
        .chip {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border-radius: 999px;
            padding: 6px 12px;
            font-weight: 800
        }

            .chip i {
                font-size: 1.05rem
            }

        .chip-pin {
            background: #f8fafc;
            border: 1px solid #e6edf2;
            color: #0f172a
        }

        .chip-meal {
            background: #fff7ed;
            border: 1px solid #ffedd5;
            color: #9a3412
        }

        .chip-hotel {
            background: #eef2ff;
            border: 1px solid #e0e7ff;
            color: #3730a3
        }

        .chip-transport {
            background: #ecfeff;
            border: 1px solid #cffafe;
            color: #155e75
        }

        .hotel-addr {
            display: block;
            margin: .15rem 0 .25rem;
            color: #64748b
        }

        /* 右側預訂盒與總金額 */
        .book-box {
            position: sticky;
            top: 88px;
            border: 1px solid #eef3f8;
            border-radius: 14px;
            padding: 16px;
            background: #fff;
            box-shadow: 0 4px 18px rgba(0,0,0,.05)
        }

        .price {
            color: #00a66a;
            font-weight: 800;
            font-size: 1.6rem
        }

        .control {
            background: #f7fbff;
            border: 1px solid #e5eef7;
            border-radius: 10px;
            padding: 10px 12px
        }

            .control + .control {
                margin-top: 10px
            }

        .people-inline {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px
        }

            .people-inline .btn {
                width: 32px;
                height: 32px;
                padding: 0
            }

        .btn-book {
            width: 100%;
            padding: 12px 0;
            font-weight: 800;
            background: #22B3C1;
            color: #fff;
            border: none;
            border-radius: 10px
        }

        .is-invalid {
            border: 2px solid #dc3545 !important;
            background: #fff5f5 !important
        }

        .total-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: 10px;
            padding-top: 10px;
            border-top: 1px dashed #e5eef7
        }

            .total-row .label {
                font-weight: 800
            }

            .total-row .value {
                font-weight: 900;
                font-size: 1.15rem;
                color: #0f766e
            }

        /* 主要畫廊 */
        .hero-img {
            width: 100%;
            aspect-ratio: 16/9;
            border-radius: 14px;
            overflow: hidden;
            background: #f7fafb
        }

            .hero-img img {
                width: 100%;
                height: 100%;
                object-fit: cover
            }

        .thumbs {
            display: grid;
            grid-template-columns: repeat(5,1fr);
            gap: 8px;
            margin-top: 8px
        }

        .thumb {
            border-radius: 10px;
            overflow: hidden;
            cursor: pointer;
            border: 2px solid transparent
        }

            .thumb.active {
                border-color: #22B3C1
            }

            .thumb img {
                width: 100%;
                aspect-ratio: 4/3;
                object-fit: cover
            }

        /* Tabs */
        .nav-tabs .nav-link {
            border: none;
            border-bottom: 3px solid transparent;
            font-weight: 800;
            color: #334155
        }

            .nav-tabs .nav-link.active {
                color: #22B3C1;
                border-color: #22B3C1
            }

        /* daterangepicker 微調 */
        .daterangepicker {
            border-radius: 16px;
            border: 1px solid #e6e6e6;
            box-shadow: 0 10px 30px rgba(0,0,0,.08);
            font-family: 'Public Sans',system-ui,-apple-system,'Noto Sans TC',sans-serif
        }

            .daterangepicker td.active, .daterangepicker td.active:hover {
                background: #22B3C1;
                border-radius: 10px;
                color: #fff !important
            }

        /* Modal 內顯示大圖避免裁切 */
        .modal .carousel-item img {
            max-height: 70vh;
            width: 100%;
            object-fit: contain
        }
    </style>
}



<div class="container page-wrap">
    <div class="layout">
        <!-- 左側主要內容 -->
        <div>
            <!-- 畫廊 -->
            <div class="hero-img" id="heroImg">
                <img src="@(string.IsNullOrWhiteSpace(Model.CoverImageUrl) ? "/images/NoImage.png" : Model.CoverImageUrl)" alt="@Model.ProductName" />
            </div>
            <div class="thumbs">
                @for (int i = 0; i < Model.ImageUrls.Count; i++)
                {
                    var u = string.IsNullOrWhiteSpace(Model.ImageUrls[i]) ? "/images/NoImage.png" : Model.ImageUrls[i];
                    <div class="thumb @(i == 0 ? "active" : "")" data-url="@u"><img src="@u" alt="img @(i + 1)" /></div>
                }
            </div>

            <div class="mt-3">
                <div class="title">@Model.ProductName</div>
                <div class="meta my-1">
                    <span class="me-2"><i class="fa-solid fa-location-dot me-1"></i>@Model.RegionName</span>
                    <span class="me-2"><i class="fa-solid fa-star me-1"></i>@Model.Rating.ToString("0.0")</span>
                    @if (!string.IsNullOrWhiteSpace(Model.DurationText))
                    {
                        <span class="me-2"><i class="fa-solid fa-clock me-1"></i>@Model.DurationText</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Category))
                    {
                        <span class="badge badge-cat rounded-pill">@Model.Category</span>
                    }
                </div>
            </div>

            <!-- Tabs -->
            <ul class="nav nav-tabs mt-4" role="tablist">
                <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-desc" type="button">簡介</button></li>
                <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-itin" type="button">行程介紹</button></li>
                <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-note" type="button">注意事項</button></li>
            </ul>

            <div class="tab-content mt-3">
                <!-- 簡介 -->
                <div class="tab-pane fade show active" id="tab-desc">
                    <div class="card-soft">
                        @if (!string.IsNullOrWhiteSpace(Model.DescriptionHtml))
                        {
                            @Html.Raw(Model.DescriptionHtml)
                        }
                        else
                        {

                            <p class="text-muted mb-0">尚未提供內容。</p>
                        }
                    </div>
                </div>

                <!-- 行程介紹 -->
                <div class="tab-pane fade" id="tab-itin">
                    <!-- 景點（改為每個景點圖文並列＋點圖開 modal 看大圖） -->
                    <div class="mb-4">
                        <div class="sec-title">景點</div>

                        @if (Model.LocationsByDay.Any())
                        {
                            foreach (var day in Model.LocationsByDay)
                            {
                                <div class="timeline card-soft">
                                    <div class="day-block">
                                        <div class="node"></div>
                                        <div class="day-title">第 @day.DayNumber 天</div>

                                        @for (int i = 0; i < day.Items.Count; i++)
                                        {
                                            var loc = day.Items[i];
                                            var imgs = loc.Pictures?.Where(u => !string.IsNullOrWhiteSpace(u)).ToList() ?? new List<string>();
                                            var cover = imgs.FirstOrDefault() ?? "/images/NoImage.png";
                                            var modalId = $"spotModal_{day.DayNumber}_{i}";

                                            <div class="spot-row">
                                                <!-- 左：文字 -->
                                                <div>
                                                    <div class="chip-pin mb-2">
                                                        <i class="fa-solid fa-location-dot text-danger"></i>
                                                        <span>@loc.Name</span>
                                                    </div>
                                                    <div class="text-muted ck-content">@Html.Raw(loc.Desc)</div>
                                                </div>

                                                <!-- 右：縮圖（點擊開 Modal 內輪播） -->
                                                <a class="spot-thumb" data-bs-toggle="modal" data-bs-target="#@modalId" title="點擊看大圖">
                                                    <img src="@cover" alt="@loc.Name" loading="lazy" />
                                                </a>
                                            </div>

                                            <!-- Modal：這個景點的相簿 -->
                                            <div class="modal fade" id="@modalId" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-lg modal-dialog-centered">
                                                    <div class="modal-content">
                                                        <div class="modal-body p-0">
                                                            @if (imgs.Count <= 1)
                                                            {
                                                                <img src="@cover" class="w-100" alt="@loc.Name" />
                                                            }
                                                            else
                                                            {
                                                                var cid = $"spotCarousel_{day.DayNumber}_{i}";
                                                                <div id="@cid" class="carousel slide" data-bs-ride="false">
                                                                    <div class="carousel-inner">
                                                                        @for (int k = 0; k < imgs.Count; k++)
                                                                        {
                                                                            <div class="carousel-item @(k == 0 ? "active" : "")">
                                                                                <img src="@imgs[k]" class="d-block w-100" alt="@loc.Name">
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                    <button class="carousel-control-prev" type="button" data-bs-target="#@cid" data-bs-slide="prev">
                                                                        <span class="carousel-control-prev-icon"></span>
                                                                    </button>
                                                                    <button class="carousel-control-next" type="button" data-bs-target="#@cid" data-bs-slide="next">
                                                                        <span class="carousel-control-next-icon"></span>
                                                                    </button>
                                                                </div>
                                                            }
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">關閉</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="card-soft text-muted">尚無景點資料</div>
                        }
                    </div>


                    <!-- 餐食（圖文並列，每個餐廳/餐點各自相簿） -->
                    <div class="mb-4">
                        <div class="sec-title">餐食</div>

                        @if (Model.MealsByDay.Any())
                        {
                            foreach (var day in Model.MealsByDay)
                            {
                                <div class="timeline card-soft">
                                    <div class="day-block">
                                        <div class="node"></div>
                                        <div class="day-title">第 @day.DayNumber 天</div>

                                        @for (int g = 0; g < day.Meals.Count; g++)
                                        {
                                            var grp = day.Meals[g];
                                            var mealTitle = grp.MealType switch { "Breakfast" => "早餐", "Lunch" => "午餐", "Dinner" => "晚餐", _ => grp.MealType };

                                            @for (int i = 0; i < grp.Items.Count; i++)
                                            {
                                                var item = grp.Items[i];
                                                var imgs = item.Pictures?.Where(u => !string.IsNullOrWhiteSpace(u)).ToList() ?? new List<string>();
                                                var cover = imgs.FirstOrDefault() ?? "/images/NoImage.png";
                                                var modalId = $"mealModal_{day.DayNumber}_{g}_{i}";

                                                <div class="spot-row">
                                                    <div>
                                                        <div class="chip chip-meal mb-2">
                                                            <i class="fa-solid fa-utensils"></i>
                                                            <span>@mealTitle</span>
                                                            @if (!string.IsNullOrWhiteSpace(item.Name))
                                                            {
                                                                <span>・@item.Name</span>
                                                            }
                                                        </div>
                                                        <div class="text-muted ck-content">
                                                            @Html.Raw(item.Desc)
                                                        </div>
                                                    </div>

                                                    <a class="spot-thumb" data-bs-toggle="modal" data-bs-target="#@modalId" title="點擊看餐食照片">
                                                        <img src="@cover" alt="@($"{mealTitle}-{item.Name}")" loading="lazy" />
                                                    </a>
                                                </div>

                                                <!-- Modal：此餐點相簿 -->
                                                <div class="modal fade" id="@modalId" tabindex="-1" aria-hidden="true">
                                                    <div class="modal-dialog modal-lg modal-dialog-centered">
                                                        <div class="modal-content">
                                                            <div class="modal-body p-0">
                                                                @if (imgs.Count <= 1)
                                                                {
                                                                    <img src="@cover" class="w-100" alt="@($"{mealTitle}-{item.Name}")" />
                                                                }
                                                                else
                                                                {
                                                                    var cid = $"mealCarousel_{day.DayNumber}_{g}_{i}";
                                                                    <div id="@cid" class="carousel slide" data-bs-ride="false">
                                                                        <div class="carousel-inner">
                                                                            @for (int k = 0; k < imgs.Count; k++)
                                                                            {
                                                                                <div class="carousel-item @(k == 0 ? "active" : "")">
                                                                                    <img src="@imgs[k]" class="d-block w-100" alt="@($"{mealTitle}-{item.Name}")">
                                                                                </div>
                                                                            }
                                                                        </div>
                                                                        <button class="carousel-control-prev" type="button" data-bs-target="#@cid" data-bs-slide="prev">
                                                                            <span class="carousel-control-prev-icon"></span>
                                                                        </button>
                                                                        <button class="carousel-control-next" type="button" data-bs-target="#@cid" data-bs-slide="next">
                                                                            <span class="carousel-control-next-icon"></span>
                                                                        </button>
                                                                    </div>
                                                                }
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">關閉</button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="card-soft text-muted">尚無餐點資料</div>
                        }
                    </div>


                    <!-- 住宿（圖文並列＋地址） -->
                    <div class="mb-4">
                        <div class="sec-title">住宿</div>

                        @if (Model.HotelsByDay.Any())
                        {
                            foreach (var day in Model.HotelsByDay)
                            {
                                <div class="timeline card-soft">
                                    <div class="day-block">
                                        <div class="node"></div>
                                        <div class="day-title">第 @day.DayNumber 天</div>

                                        @for (int i = 0; i < day.Items.Count; i++)
                                        {
                                            var h = day.Items[i];
                                            var imgs = h.Pictures?.Where(u => !string.IsNullOrWhiteSpace(u)).ToList() ?? new List<string>();
                                            var cover = imgs.FirstOrDefault() ?? "/images/NoImage.png";
                                            var modalId = $"hotelModal_{day.DayNumber}_{i}";

                                            <div class="spot-row">
                                                <div>
                                                    <div class="chip chip-hotel mb-2">
                                                        <i class="fa-solid fa-bed"></i>
                                                        <span>@h.Name</span>
                                                    </div>
                                                    @if (!string.IsNullOrWhiteSpace(h.Addr))
                                                    {
                                                        <small class="hotel-addr"><i class="fa-solid fa-location-dot me-1"></i>@h.Addr</small>
                                                    }
                                                    <div class="text-muted ck-content">@Html.Raw(h.Desc)</div>
                                                </div>

                                                <a class="spot-thumb" data-bs-toggle="modal" data-bs-target="#@modalId" title="點擊看住宿照片">
                                                    <img src="@cover" alt="@h.Name" loading="lazy" />
                                                </a>
                                            </div>

                                            <!-- Modal：此住宿相簿 -->
                                            <div class="modal fade" id="@modalId" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-lg modal-dialog-centered">
                                                    <div class="modal-content">
                                                        <div class="modal-body p-0">
                                                            @if (imgs.Count <= 1)
                                                            {
                                                                <img src="@cover" class="w-100" alt="@h.Name" />
                                                            }
                                                            else
                                                            {
                                                                var cid = $"hotelCarousel_{day.DayNumber}_{i}";
                                                                <div id="@cid" class="carousel slide" data-bs-ride="false">
                                                                    <div class="carousel-inner">
                                                                        @for (int k = 0; k < imgs.Count; k++)
                                                                        {
                                                                            <div class="carousel-item @(k == 0 ? "active" : "")">
                                                                                <img src="@imgs[k]" class="d-block w-100" alt="@h.Name">
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                    <button class="carousel-control-prev" type="button" data-bs-target="#@cid" data-bs-slide="prev">
                                                                        <span class="carousel-control-prev-icon"></span>
                                                                    </button>
                                                                    <button class="carousel-control-next" type="button" data-bs-target="#@cid" data-bs-slide="next">
                                                                        <span class="carousel-control-next-icon"></span>
                                                                    </button>
                                                                </div>
                                                            }
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">關閉</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="card-soft text-muted">尚無住宿資料</div>
                        }
                    </div>



                    <!-- 交通（清單每一項皆圖文並列） -->
                    <div class="mb-4">
                        <div class="sec-title">交通</div>

                        @if (Model.Transports.Any())
                        {
                            <div class="card-soft">
                                @for (int i = 0; i < Model.Transports.Count; i++)
                                {
                                    var t = Model.Transports[i];
                                    var imgs = t.Pictures?.Where(u => !string.IsNullOrWhiteSpace(u)).ToList() ?? new List<string>();
                                    var cover = imgs.FirstOrDefault() ?? "/images/NoImage.png";
                                    var modalId = $"transModal_{i}";

                                    <div class="spot-row">
                                        <div>
                                            <div class="chip chip-transport mb-2">
                                                <i class="fa-solid fa-bus"></i>
                                                <span>@t.Name</span>
                                            </div>
                                            <div class="text-muted ck-content">@Html.Raw(t.Desc)</div>
                                        </div>

                                        <a class="spot-thumb" data-bs-toggle="modal" data-bs-target="#@modalId" title="點擊看交通照片">
                                            <img src="@cover" alt="@t.Name" loading="lazy" />
                                        </a>
                                    </div>

                                    <!-- Modal：此交通相簿 -->
                                    <div class="modal fade" id="@modalId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-lg modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-body p-0">
                                                    @if (imgs.Count <= 1)
                                                    {
                                                        <img src="@cover" class="w-100" alt="@t.Name" />
                                                    }
                                                    else
                                                    {
                                                        var cid = $"transCarousel_{i}";
                                                        <div id="@cid" class="carousel slide" data-bs-ride="false">
                                                            <div class="carousel-inner">
                                                                @for (int k = 0; k < imgs.Count; k++)
                                                                {
                                                                    <div class="carousel-item @(k == 0 ? "active" : "")">
                                                                        <img src="@imgs[k]" class="d-block w-100" alt="@t.Name">
                                                                    </div>
                                                                }
                                                            </div>
                                                            <button class="carousel-control-prev" type="button" data-bs-target="#@cid" data-bs-slide="prev">
                                                                <span class="carousel-control-prev-icon"></span>
                                                            </button>
                                                            <button class="carousel-control-next" type="button" data-bs-target="#@cid" data-bs-slide="next">
                                                                <span class="carousel-control-next-icon"></span>
                                                            </button>
                                                        </div>
                                                    }
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">關閉</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="card-soft text-muted">尚無交通資料</div>
                        }
                    </div>

                </div>

                <!-- 注意事項 -->
                <div class="tab-pane fade" id="tab-note">
                    <div class="card-soft">
                        @if (!string.IsNullOrWhiteSpace(Model.NoteHtml))
                        {
                            @Html.Raw(Model.NoteHtml)
                        }
                        else
                        {

                            <p class="text-muted mb-0">尚未提供內容。</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- 右側預訂盒 -->
        <aside>
            <div class="book-box">
                <!-- 將單價寫入 data-unit，方便 JS 讀取 -->
                <div class="price mb-1" id="unitPrice" data-unit="@Model.ProductPrice">NT$ @Model.ProductPrice.ToString("N0") <span class="text-muted fs-6">起</span></div>
                <div class="small text-muted mb-2">價格依日期與方案而異</div>

                <form asp-area="CustomersArea" asp-controller="Cart" asp-action="Add" method="post" id="bookForm">
                    <input type="hidden" name="productId" value="@Model.ProductID" />
                    <input type="hidden" name="start" id="startDate" />
                    <input type="hidden" name="people" id="peopleInput" value="1" />

                    <div class="control">
                        <label class="form-label mb-1 fw-bold"><i class="fa-solid fa-calendar-day me-1"></i> 選擇出發日期</label>
                        <input type="text" class="form-control" id="dateLabel"
                               data-min="@minDate:yyyy-MM-dd"
                               data-max="@(maxDate?.ToString("yyyy-MM-dd") ?? "")"
                               placeholder="選擇出發日期" readonly />
                    </div>

                    <div class="control">
                        <label class="form-label mb-1 fw-bold"><i class="fa-solid fa-user-group me-1"></i> 旅客</label>
                        <div class="people-inline">
                            <span id="peopleLabel" class="fw-semibold">1 位旅客</span>
                            <div>
                                <button type="button" class="btn btn-outline-secondary btn-sm" id="minus">-</button>
                                @* <span id="peopleCount" class="fw-semibold">1</span> *@
                                <button type="button" class="btn btn-outline-secondary btn-sm" id="plus">+</button>
                            </div>
                        </div>
                    </div>

                    <!-- 總金額 -->
                    <div class="total-row">
                        <span class="label">總金額</span>
                        <span class="value" id="totalAmount">NT$ 0</span>
                    </div>

                    <button type="submit" class="btn-book mt-2">加入購物車</button>
                </form>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/moment/min/moment.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        (function () {
            // 畫廊
            $('.thumb').on('click', function () {
                $('.thumb').removeClass('active'); $(this).addClass('active');
                $('#heroImg img').attr('src', $(this).data('url'));
            });

            // 單價（來自 data-unit）
            const unit = (() => {
                const v = Number($('#unitPrice').data('unit'));
                return isNaN(v) ? 0 : v;
            })();

            // 千分位/貨幣
            const fmtCurrency = n => new Intl.NumberFormat('zh-TW', { style: 'currency', currency: 'TWD', maximumFractionDigits: 0 }).format(n);

            // 旅客數 + 總金額同步
            let cnt = 2;
            function updateTotal() {
                $('#totalAmount').text(fmtCurrency(unit * cnt));
            }
            function sync() {
                $('#peopleCount').text(cnt);
                $('#peopleLabel').text(cnt + ' 位旅客');
                $('#peopleInput').val(cnt);
                updateTotal();
            }
            $('#plus').on('click', e => { e.preventDefault(); cnt++; sync(); });
            $('#minus').on('click', e => { e.preventDefault(); if (cnt > 1) cnt--; sync(); });
            sync();

            // 日期（單日）
            $('#dateLabel').daterangepicker({
                singleDatePicker: true,
                autoUpdateInput: false,
                showDropdowns: true,
                alwaysShowCalendars: true,
                opens: 'center',
                minDate: moment(),
                locale: {
                    format: 'YYYY-MM-DD',
                    cancelLabel: '清除',
                    applyLabel: '確定',
                    daysOfWeek: ['日', '一', '二', '三', '四', '五', '六'],
                    monthNames: ['一月','二月','三月','四月','五月','六月','七月','八月','九月','十月','十一月','十二月'],
                    firstDay: 0
                },
                linkedCalendars: true,
                autoApply: true,
            })
            .on('apply.daterangepicker', function (ev, picker) {
                let s = picker.startDate.clone().startOf('day');
                $('#startDate').val(s.format('YYYY-MM-DD'));
                $('#dateLabel').val(s.format('YYYY-MM-DD'));
            })
            .on('cancel.daterangepicker', function () {
                $(this).val('');
                $('#startDate').val('');
            });

            // 送出驗證（只檢查 start）
            $('#bookForm').on('submit', function (e) {
                e.preventDefault();

                if (!$('#startDate').val()) {
                    $('#dateLabel').addClass('is-invalid');
                    Swal.fire({ icon: 'warning', title: '請先選擇日期', confirmButtonColor: '#22B3C1' });
                    return false;
                }

                const form = e.target;
                const formData = new FormData(form);

                fetch(form.action, { method: 'POST', body: formData })
                    .then(r => r.json())
                    .then(data => {
                        if (data.ok) {
                            Swal.fire({ icon: 'success', title: '已加入購物車', showConfirmButton: false, timer: 1500 });
                            if (typeof updateCartCount === 'function') updateCartCount(data.count);
                        } else {
                            Swal.fire({ icon: 'error', title: '加入失敗', text: data.error || '發生未知的錯誤', confirmButtonColor: '#22B3C1' });
                        }
                    })
                    .catch(err => {
                        console.error('Error:', err);
                        Swal.fire({ icon: 'error', title: '發生錯誤', text: '無法連線到伺服器', confirmButtonColor: '#22B3C1' });
                    });
            });
        })();
    </script>
}
