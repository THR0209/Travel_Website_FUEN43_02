    <script>

        // 共用：建立一個 Vue + Swiper 幫手
        function mountFeatured(appId, apiUrl, swiperSelector, prevEl, nextEl){
          const app = Vue.createApp({
            data(){ return { items: [] }; },
            mounted(){
              axios.get(apiUrl)
                .then(res => { this.items = res.data || []; })
                .then(() => this.$nextTick(() => {
                  new Swiper(swiperSelector, {
                    slidesPerView: 1.2,
                    spaceBetween: 20,
                    navigation: { prevEl, nextEl },
                    breakpoints: {
                      576:{ slidesPerView:2 },
                      768:{ slidesPerView:3 },
                      992:{ slidesPerView:4 }
                    }
                  });
                }))
                .catch(err => console.error('載入失敗：', apiUrl, err));
            }
          });
          app.mount(appId);
        }

        // 住宿 / 門票 / 交通
        mountFeatured('#hot-app',    '/CustomersArea/Products/GetHotProducts',    '.hot-swiper',    '.hot-prev',    '.hot-next');
