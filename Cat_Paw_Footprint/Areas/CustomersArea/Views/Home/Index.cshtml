        // ====================== FAQ 熱門資料載入 ======================
        document.addEventListener('DOMContentLoaded', async () => {
            const faqListContainer = document.getElementById('faqList');
            try {
                const response = await axios.get('/CustomersArea/FrontFAQs/api/hot');
                const faqs = response.data;

                if (!faqs || faqs.length === 0) {
                    faqListContainer.innerHTML = `
                        <div class="text-center text-muted py-5">
                            <i class="fa-solid fa-cat" style="font-size:2rem;"></i>
                            <p class="mt-3">目前沒有熱門常見問題喔 🐾</p>
                        </div>`;
                    return;
                }

                let html = '';
                faqs.forEach(faq => {
                    html += `
                        <div class="faq-item">
                            <div class="faq-question">
                                <span><i class="fa-solid fa-paw me-2"></i>${faq.question}</span>
                                <i class="fa-solid fa-chevron-down"></i>
                            </div>
                            <div class="faq-answer">${faq.answer}</div>
                        </div>`;
                });
                faqListContainer.innerHTML = html;

                const faqItems = document.querySelectorAll('.faq-item');
                faqItems.forEach(item => {
                    const q = item.querySelector('.faq-question');
                    q.addEventListener('click', () => {
                        faqItems.forEach(i => {
                            if (i !== item) i.classList.remove('active');
                        });
                        item.classList.toggle('active');
                    });
                });
            } catch (err) {
                console.error('載入 FAQ 失敗：', err);
                faqListContainer.innerHTML = `<div class="alert alert-danger">
                    無法載入熱門常見問題，請稍後再試。
                </div>`;
            }

            // 只有首頁才啟用滾動（避免其他頁誤觸）
            if (window.isHomePage && window.location.hash === '#faqSection') {
                const faqTarget = document.querySelector('#faqSection');
                if (faqTarget) {
                    setTimeout(() => {
                        window.scrollTo({
                            top: faqTarget.offsetTop - 60,
                            behavior: 'smooth'
                        });
                    }, 400);
                }
            }
        });

    </script>

    <!-- daterangepicker -->
    <script src="https://cdn.jsdelivr.net/npm/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/moment/min/moment.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />

    <script>
        // Tab 對應不同搜尋欄內容
        const SEARCH_CONFIG = {
          trip: {
            destinationPlaceholder: "想去哪裡玩？（例：台北、新北、花蓮）",
            dateLabel: "旅行日期",
            peopleLabel: "人數"
          },
          hotel: {
            destinationPlaceholder: "搜尋城市、區域或飯店名稱",
            dateLabel: "入住 - 退房",
            peopleLabel: "房客"
          },
          ticket: {
            destinationPlaceholder: "搜尋景點或城市名稱",
            dateLabel: "使用日期",
            peopleLabel: "入場人數"
          },
          car: {
            destinationPlaceholder: "取車地點（例：台北車站、高雄左營）",
            dateLabel: "取車 - 還車日期",
            peopleLabel: "乘客人數"
          }
        };

        /* ===== 搜尋列互動（修正冒泡與面板關閉） ===== */
        // Tab
        $('.search-tab').on('click', function () {
          $('.search-tab').removeClass('active');
          $(this).addClass('active');
          const type = $(this).data('type');
          $('#searchType').val(type);

          // ✅ 套用對照表更新 UI
          $('#destinationInput').attr('placeholder', SEARCH_CONFIG[type].destinationPlaceholder);
          $('#peopleLabel').text(SEARCH_CONFIG[type].peopleLabel + "： " + $('#peopleCount').text());
          
          // ✅ 切換分類時重置旅客數
          cnt = 2;
          syncPeople();

          // ✅ 切換時清除前面所選的內容
          $('#destinationInput').val('');
          $('#dateLabel').val('');
          $('#startDate').val('');
          $('#endDate').val('');
          $('#peopleInput').val('2');
        });

        // 建議清單
        const TW_DESTS = [
          "台北","新北","基隆","桃園","新竹","苗栗","台中","彰化","雲林","南投","嘉義","台南","高雄","屏東",
          "宜蘭","花蓮","台東","澎湖","金門","連江（馬祖）","綠島","小琉球","蘭嶼"
        ];

        function renderSuggest(list){
          const box = $('#destSuggest').empty();
          list.forEach(name=>{
            $('<div>', {class:'suggest-item badge text-dark', text:name})
              .appendTo(box)
              .on('mousedown', function(e){ // 用 mousedown 先於 document 觸發
                e.stopPropagation();
                $('#destinationInput').val(name).trigger('change').blur();
                closeAllDropdowns();
              });
          });
        }
        renderSuggest(TW_DESTS);

        function openDest(){ $('#destPanel').show(); }
        function closeAllDropdowns(){ $('.dropdown-panel').hide(); }

        // 目的地外層：只有點「非 input 區域」才切換面板
        $('#destSelect').on('mousedown', function(e){
          if ($(e.target).is('#destinationInput')) return;
          e.stopPropagation();
          renderSuggest(TW_DESTS); // ✅ 永遠重新載入完整清單
          $('#destPanel').toggle();
        });

        // 目的地輸入框：focus / input / click / mousedown 全部阻止冒泡，並顯示面板
        $('#destinationInput')
          .on('focus input click mousedown', function(e){
            e.stopPropagation();

            // ✅ 關閉日期選擇器
            if ($('#dateLabel').data('daterangepicker'))
                $('#dateLabel').data('daterangepicker').hide();

            const q = $(this).val().trim();
            const filtered = q ? TW_DESTS.filter(x => x.toLowerCase().includes(q.toLowerCase())) : TW_DESTS;
            // renderSuggest(filtered.length ? filtered : TW_DESTS);
            openDest();
          });


        // 面板本體：阻止事件冒泡，不讓 document 關掉
        $('#destPanel').on('mousedown click', function(e){ e.stopPropagation(); });

        // 全域點擊 / 按下關閉所有下拉（mousedown 能更早吃到事件，避免閃現）
        $(document).on('mousedown click', function(){ closeAllDropdowns(); });

        /* 旅客數（內嵌控制） */
        let cnt = Number($('#peopleInput').val() || 2);
        function syncPeople(){
          $('#peopleCount').text(cnt);
          $('#peopleLabel').text(cnt + ' 位旅客');
          $('#peopleInput').val(cnt);
        }
        $('#plus').on('click', function(e){ e.preventDefault(); e.stopPropagation(); cnt++; syncPeople(); });
        $('#minus').on('click', function(e){ e.preventDefault(); e.stopPropagation(); if(cnt>1){ cnt--; syncPeople(); }});
        syncPeople();

        /* 日期：daterangepicker（僅日期，不含時間） */
        $('#dateLabel').daterangepicker({
          autoUpdateInput: false,
          minDate: moment().startOf('day'), // ✅ 禁止選過去
          locale: { format: 'YYYY/MM/DD', cancelLabel: '清除', applyLabel:'確定' }
        }, function(start, end){
          $('#startDate').val(start.format('YYYY/MM/DD'));
          $('#endDate').val(end.format('YYYY/MM/DD'));
          $('#dateLabel').val(start.format('YYYY/MM/DD') + ' - ' + end.format('YYYY/MM/DD'));
        }).on('cancel.daterangepicker', function(){
          $(this).val('');
          $('#startDate,#endDate').val('');
        });

        // 表單送出（若要驗證可在這裡做）
        $('#topSearchForm').on('submit', function (e) {

            let destination = $('#destinationInput').val().trim();
            let start = $('#startDate').val().trim();
            let end = $('#endDate').val().trim();

            let isValid = true;

            // 清除之前的錯誤樣式
            $('#destinationInput').removeClass('is-invalid');
            $('#dateLabel').removeClass('is-invalid');

            // ✅ 驗證目的地
            if (destination === "") {
                $('#destinationInput').addClass('is-invalid');
                isValid = false;
            }

            // ✅ 驗證日期
            if (start === "" || end === "") {
                $('#dateLabel').addClass('is-invalid');
                isValid = false;
            }

            // ❌ 若不通過 → 用 SweetAlert 提示
            if (!isValid) {
                e.preventDefault();
                Swal.fire({
                    icon: 'warning',
                    title: '資訊尚未填寫完整',
                    text: '請選擇「目的地」及「旅行日期」。',
                    confirmButtonColor: '#22B3C1',
                    confirmButtonText: '我知道了'
                });
                return false;
            }

            // ✅ 通過 → 放行表單
            return true;
        });


    </script>
}