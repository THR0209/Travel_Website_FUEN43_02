
@{
    ViewData["Title"] = "首頁";
    var isHomePage =
        string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Home", StringComparison.OrdinalIgnoreCase) &&
        string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Index", StringComparison.OrdinalIgnoreCase) &&
        string.Equals(ViewContext.RouteData.Values["area"]?.ToString(), "CustomersArea", StringComparison.OrdinalIgnoreCase);
}

<script>
    window.isHomePage = @(isHomePage.ToString().ToLower());
</script>

@section Styles {
    <style>
        /* 統一標題風格 */
        .section-title h2 {
            font-weight: bold;
            letter-spacing: 2px;
            text-align: center;
        }

        .section-title div {
            width: 60px;
            height: 3px;
            background: #7ec8e3;
            margin: 10px auto 0;
            border-radius: 2px;
        }

        /* 手風琴樣式 */
        .accordion-button {
            background-color: #f7fbff;
            color: #2255aa;
            border-radius: 12px !important;
            transition: all .3s;
        }

            .accordion-button:not(.collapsed) {
                background-color: #e6f4ff;
                color: #226dd3;
                box-shadow: inset 0 -1px 0 rgba(0,0,0,0.1);
            }

            .accordion-button:focus {
                box-shadow: 0 0 0 0.25rem rgba(34,109,211,0.2);
                border-color: #7ec8e3;
            }

        .accordion-body {
            background: #fff;
            border-radius: 0 0 12px 12px;
            color: #444;
        }

        .accordion-item {
            border: 1px solid #d8ebff;
        }

        .accordion-button::after {
            filter: hue-rotate(180deg);
        }
    </style>

    <style>
        /* ===== Banner / 搜尋列（新增與修正） ===== */
        .hero {
            position: relative;
            width: 100%;
            height: 480px;
            overflow: visible; /* 允許下拉超出 Banner */
        }

        #heroMedia {
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: brightness(0.65);
            border-radius: 16px; /* 圓角交給圖片 */
            pointer-events: none; /* 讓點擊穿透到上層搜尋列 */
        }

        .hero-content {
            display: none;
        }

        .search-wrapper {
            position: absolute;
            left: 50%;
            bottom: 40px;
            transform: translateX(-50%);
            width: 85%;
            max-width: 1100px;
            background: rgba(255,255,255,.94);
            border-radius: 20px;
            box-shadow: 0 6px 25px rgba(0,0,0,.30);
            padding: 18px;
            z-index: 1000;
            pointer-events: auto;
        }

        .search-tabs {
            display: flex;
            gap: 10px;
            margin-bottom: 12px;
        }

        .search-tab {
            padding: 6px 16px;
            border-radius: 25px;
            cursor: pointer;
            font-weight: 600;
            transition: .25s;
            user-select: none;
        }

            .search-tab.active {
                background: #7ec8e3;
                color: #fff;
            }

        .search-box {
            display: grid;
            gap: 10px;
            align-items: center;
            grid-template-columns: 2.2fr 2.2fr 1.6fr 140px; /* 目的地 / 日期 / 旅客(內嵌) / 搜尋 */
        }

        .search-select {
            background: #F2FAFF;
            padding: 12px 14px;
            border-radius: 12px;
            border: 1px solid #dceeff;
            position: relative;
        }

            .search-select:focus-within {
                border-color: #7ec8e3;
            }

        .search-input {
            width: 100%;
            border: none;
            outline: none;
            background: transparent;
            font-weight: 600;
            color: #222;
        }

            .search-input::placeholder {
                color: #6b7d90;
                font-weight: 500;
            }

        .dropdown-panel {
            position: absolute;
            top: 115%;
            left: 0;
            width: 100%;
            min-width: 340px;
            background: #fff;
            padding: 12px;
            border-radius: 14px;
            box-shadow: 0 6px 18px rgba(0,0,0,.25);
            display: none;
            z-index: 10000;
        }

        .suggest-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0,1fr));
            gap: 8px;
        }

        .suggest-item {
            cursor: pointer;
            padding: 8px 10px;
            border: 1px solid #eef3fb;
            border-radius: 10px;
            background: #fafcff;
            font-size: 0.95rem;
        }

            .suggest-item:hover {
                background: #eef8fb;
                border-color: #d5eef5;
            }

        /* 旅客數：改為內嵌控制（無下拉） */
        .people-inline {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
        }

            .people-inline .ctrl {
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .people-inline button {
                width: 32px;
                height: 32px;
                line-height: 30px;
                align-items: center;
                /* text-align: center; */
            }

        .search-btn {
            background: #7ec8e3;
            color: #fff;
            border: none;
            border-radius: 12px;
            font-weight: 700;
            padding: 14px 0;
            width: 100%;
        }

        /* 讓人數欄位自動撐到和其他 search-select 一樣高度 */
        .search-select .people-inline {
            height: 100%;
        }

        /* ===== Swiper Arrow Buttons ===== */
        .swiper-btn {
            width: 38px;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fff;
            border-radius: 50%;
            box-shadow: 0 3px 8px rgba(0,0,0,0.15);
            cursor: pointer;
            transition: all .25s;
            color: #22B3C1;
        }

            .swiper-btn:hover {
                background: #22B3C1;
                color: #fff;
                box-shadow: 0 4px 10px rgba(34,179,193,0.4);
            }

        .swiper-nav {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .product-title {
            display: -webkit-box; /* 建立多行彈性盒 */
            -webkit-box-orient: vertical; /* 垂直方向排列 */
            -webkit-line-clamp: 2; /* 限制為 2 行 */
            overflow: hidden; /* 超出隱藏 */
            text-overflow: ellipsis; /* 加上省略號 */
            white-space: normal; /* 允許換行 */
            word-break: break-word; /* 中文或長字自動斷行 */
            min-height: 3em; /* 避免只有一行時高度不齊 */
        }



        /* 讓數字與字不會撐大高度 */
        .people-inline span,
        .people-inline .ctrl * {
            line-height: 1.2; /* 可依視覺調整 */
        }


        /* 裝飾（避免擋點擊） */
        .floating-paws {
            pointer-events: none;
            z-index: 10;
        }
    </style>

    <style>
        /* ====================== FAQ ====================== */
        #faqSection {
            background: linear-gradient(180deg, #f8fbff 0%, #ffffff 100%);
            padding: 3rem 2rem;
            border-radius: 20px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        }

        .faq-item {
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.05);
            margin-bottom: 1rem;
            transition: all 0.3s ease;
            overflow: hidden;
            border: 1px solid #d8ebff;
        }

            .faq-item:hover {
                transform: scale(1.01);
                box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
            }

        .faq-question {
            background: linear-gradient(90deg, #eaf6ff, #f9f9fd);
            color: #2255aa;
            font-weight: 600;
            padding: 1.1rem 1.5rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 1.1rem;
            transition: background .3s, color .3s;
        }

            .faq-question i {
                transition: transform .3s ease;
                color: #7ec8e3;
            }

        .faq-item.active .faq-question {
            background: linear-gradient(90deg, #dff1ff, #f4faff);
            color: #226dd3;
        }

            .faq-item.active .faq-question i {
                transform: rotate(180deg);
            }

        .faq-answer {
            padding: 1.2rem 1.5rem;
            color: #444;
            display: none;
            line-height: 1.8;
            background: #fff;
            border-top: 1px solid #d8ebff;
            font-size: 1rem;
        }

        .faq-item.active .faq-answer {
            display: block;
            animation: fadeIn .4s ease;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-6px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width: 768px) {
            .faq-question {
                font-size: 1rem;
                padding: 1rem 1.2rem;
            }

            .faq-answer {
                font-size: 0.95rem;
                padding: 1rem 1.2rem;
            }
        }
    </style>
}

<!-- Hero -->
<!-- ===== Hero / Banner ===== -->
<section class="hero mt-3">
    <img src="https://images.unsplash.com/photo-1519052537078-e6302a4968d4?q=80&w=1800&auto=format&fit=crop" alt="帶貓旅行的海邊日落" id="heroMedia" />
    
    <!-- Trip.com 風格搜尋列 -->
    <div class="search-wrapper">
        <h1 class="display-6 fw-bolder mb-3">帶著毛孩去旅行，探索下一站</h1>
        <!-- 分類 Tab -->
        <div class="search-tabs">
            <div class="search-tab active" data-type="trip">套裝行程</div>
            <div class="search-tab" data-type="hotel">住宿</div>
            <div class="search-tab" data-type="ticket">景點門票</div>
            <div class="search-tab" data-type="car">租車</div>
        </div>

        <!-- 搜尋表單（跳轉到後端搜尋） -->
        <form asp-area="CustomersArea" asp-controller="Products" asp-action="Search" method="get" id="topSearchForm">
            <input type="hidden" name="type" id="searchType" value="trip" />
            <input type="hidden" name="start" id="startDate" />
            <input type="hidden" name="end" id="endDate" />
            <input type="hidden" name="people" id="peopleInput" value="2" />

            <div class="search-box">
                <!-- 目的地（可輸入 + 建議；點選後會關閉下拉） -->
                <div class="search-select" id="destSelect">
                    <label class="float-label">目的地</label>
                    <input type="text" class="search-input" id="destinationInput" name="destination"
                           placeholder="請輸入或選擇目的地" autocomplete="off" />
                    <div class="dropdown-panel" id="destPanel">
                        <div class="mb-2 fw-bold">熱門目的地</div>
                        <div class="suggest-grid" id="destSuggest"></div>
                    </div>
                </div>

                <!-- 日期（daterangepicker：起訖 + 時間） -->
                <div class="search-select">
                    <label class="float-label">出發時間-返程時間</label>
                    <input type="text" class="search-input" id="dateLabel" placeholder="選擇日期與時間" autocomplete="off" />
                </div>

                <!-- 旅客數（內嵌控制，無下拉） -->
                <div class="search-select">
                    <label class="float-label">人數</label>
                    <div class="people-inline">
                        <span class="fw-semibold" id="peopleLabel"><span class="fw-semibold" id="peopleCount">2</span> 位旅客</span>
                        <div class="ctrl">
                            <button type="button" class="btn btn-outline-secondary btn-sm rounded" id="minus"><i class="fa-solid fa-minus"></i></button>
                            <button type="button" class="btn btn-outline-secondary btn-sm rounded" id="plus"><i class="fa-solid fa-plus"></i></button>
                        </div>
                    </div>
                </div>

                <!-- 搜尋 -->
                <button type="submit" class="btn btn-outline-primary">搜尋</button>
            </div>
        </form>
    </div>

    <!-- 飄浮貓掌裝飾 -->
    <div class="floating-paws" aria-hidden="true">
        <span>🐾</span><span>🐾</span><span>🐾</span>
    </div>
</section>



<!-- 為你精選熱門行程 -->
<section class="section" id="hotProducts" v-cloak>
    <div class="container" id="hot-app">
        <div class="section-title text-center mb-4">
            <h2 class="fw-bold" style="letter-spacing:2px;color:#22B3C1;">
                <i class="fa-solid fa-paw me-2"></i>精選熱門行程
            </h2>
            <div style="width:60px; height:3px; background:#22B3C1; margin:10px auto 0; border-radius:2px;"></div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <a href="/CustomersArea/Products/Search" class="btn btn-outline-primary rounded-pill fw-bold">
                查看所有行程 <i class="fa-solid fa-arrow-right ms-2"></i>
            </a>
            <div class="swiper-nav d-flex align-items-center gap-2">
                <div class="swiper-btn hot-prev"><i class="fa-solid fa-chevron-left"></i></div>
                <div class="swiper-btn hot-next"><i class="fa-solid fa-chevron-right"></i></div>
            </div>
        </div>

        <!-- Swiper -->
        <div class="swiper hot-swiper" aria-label="熱門商品輪播">
            <div class="swiper-wrapper">
                <div class="swiper-slide" v-for="p in items" :key="p.productID">
                    <article class="product-card shadow-sm">
                        <div class="product-thumb position-relative">
                            <img :src="p.cover" class="w-100 rounded-top" :alt="p.productName">
                            <span class="badge bg-info position-absolute top-0 start-0 m-2">🔥 熱門</span>
                        </div>
                        <div class="product-body p-3">
                            <h5 class="fw-bold mb-1 product-title">{{ p.productName }}</h5>
                            <p class="text-muted mb-1"><i class="fa-solid fa-location-dot me-1 text-secondary"></i>{{ p.region }}</p>
                            <div class="fw-bold text-primary">NT$ {{ p.price }} 起</div>
                        </div>
                        <!-- 新增 查看詳情按鈕 -->
                        <a :href="'/CustomersArea/Products/Details/' + p.productID"
                           class="btn btn-outline-primary w-100 rounded-pill fw-bold">
                            查看詳情
                            <i class="fa-solid fa-arrow-right ms-1"></i>
                        </a>
                    </article>
                </div>
            </div>
        </div>
    </div>
</section>

