@{
    ViewData["Title"] = "我的優惠券";
}

<div id="coupon-app" class="coupon-wrapper container py-5">
    <h2 class="text-center mb-5 fw-bold text-primary">
        <i class="fa-solid fa-ticket me-2"></i> 我的優惠券
    </h2>

    <!-- Tabs -->
    <ul class="nav nav-pills justify-content-center mb-4 coupon-tabs">
        <li class="nav-item">
            <button class="nav-link"
                    :class="{ active: tab === 'usable' }"
                    v-on:click="tab = 'usable'">
                可使用
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link"
                    :class="{ active: tab === 'used' }"
                    v-on:click="tab = 'used'">
                已使用
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link"
                    :class="{ active: tab === 'expired' }"
                    v-on:click="tab = 'expired'">
                無法使用
            </button>
        </li>
    </ul>

    <!-- Coupon Cards -->
    <div class="row g-4 justify-content-center">

        <!-- 可使用 -->
        <template v-if="tab === 'usable' && coupons.usable.length">
            <div v-for="c in coupons.usable" :key="c.couponId" class="col-md-6 col-lg-4">
                <div class="coupon-card usable">
                    <div class="coupon-body">
                        <h5 class="fw-bold mb-2 text-brand">{{ c.couponName }}</h5>
                        @* <p class="mb-1 text-secondary">訂購金額須滿 TWD {{ c.minimumAmount || 0 }}</p> *@
                        <p class="mb-1 text-secondary">{{ c.rule }}</p>
                        <p class="mb-1">{{ c.desc }}</p>
                        <small class="text-muted">有效期限：{{ formatDate(c.endDate) }}</small>
                    </div>
                    <div class="coupon-ribbon">可使用</div>
                </div>
            </div>
        </template>
        <!-- 已使用 -->
        <template v-if="tab === 'used' && coupons.used.length">
            <div v-for="c in coupons.used" :key="c.couponId" class="col-md-6 col-lg-4">
                <div class="coupon-card used">
                    <div class="coupon-body">
                        <h5 class="fw-bold mb-2 text-secondary">{{ c.couponName }}</h5>
                        <p class="mb-1 text-secondary">{{ c.desc }}</p>
                        <small class="text-muted">已使用</small>
                    </div>
                    <div class="coupon-ribbon gray">已使用</div>
                </div>
            </div>
        </template>

        <!-- 無法使用 -->
        <template v-if="tab === 'expired' && coupons.expired.length">
            <div v-for="c in coupons.expired" :key="c.couponId" class="col-md-6 col-lg-4">
                <div class="coupon-card expired">
                    <div class="coupon-body">
                        <h5 class="fw-bold mb-2 text-danger">{{ c.couponName }}</h5>
                        <p class="mb-1 text-danger">{{ c.desc }}</p>
                        <small class="text-muted">已過期</small>
                    </div>
                    <div class="coupon-ribbon danger">已過期</div>
                </div>
            </div>
        </template>

        <!-- 無資料 -->
        <div v-if="currentTabList.length === 0" class="text-center text-muted py-5">
            <p>目前沒有這類優惠券 💤</p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/vue@3/dist/vue.global.prod.js"></script>
    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    tab: 'usable',
                    coupons: { usable: [], used: [], expired: [] }
                };
            },
            computed: {
                currentTabList() {
                    return this.coupons[this.tab] || [];
                }
            },
            mounted() {
                this.loadCoupons();
            },
            methods: {
                async loadCoupons() {
                    try {
                        const response = await fetch('/CustomersArea/Coupons/GetMyCoupons');
                        this.coupons = await response.json();
                         // console.log("API 回傳資料:", this.coupons);
                    } catch (err) {
                        console.error("載入優惠券失敗：", err);
                    }
                },
                formatDate(dateStr) {
                    if (!dateStr) return "-";
                    const date = new Date(dateStr);
                    return date.toLocaleDateString('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' });
                },
                displayDiscount(coupon) {
                    if (coupon.discountType === 1)
                        return `TWD ${coupon.discountValue}`;
                    if (coupon.discountType === 2)
                        return `${(coupon.discountValue * 100)} 折`;
                    return '優惠券';
                }
            }
        }).mount('#coupon-app');
    </script>
}
