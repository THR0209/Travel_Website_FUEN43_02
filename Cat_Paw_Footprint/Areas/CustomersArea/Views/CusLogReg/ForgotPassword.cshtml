@{
    ViewData["Title"] = "忘記密碼";
}
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery antiforgery
@{
    var tokens = antiforgery.GetAndStoreTokens(Context);
}
<meta name="csrf-token" content="@tokens.RequestToken" />

<div id="forgotApp" class="auth-wrapper">
    <div class="card">
        <h3 class="text-center mb-4 fw-bold">🐾 忘記密碼</h3>

        <form v-on:submit.prevent="sendMail" novalidate>
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label fw-semibold">電子郵件</label>
                <input type="email" class="form-control" v-model="form.email" required placeholder="請輸入註冊時使用的 Email" />
            </div>

            <button type="submit" class="btn btn-outline-primary w-100 py-2 fw-semibold" :disabled="sending">
                {{ sending ? "寄送中..." : "寄送重設信件" }}
            </button>
        </form>

        <div v-if="message" class="text-center mt-4">
            <span :style="{ color: messageColor, fontWeight: '600' }">{{ message }}</span>
        </div>

        <div class="text-center mt-3 bottom-links">
            <a href="/CustomersArea/CusLogReg/Login" class="text-decoration-none">返回登入頁</a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    sending: false,
                    message: "",
                    messageColor: "#555",
                    form: { email: "" }
                };
            },
            methods: {
                async sendMail() {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                    this.message = "";
                    this.sending = true;

                    try {
                        const res = await axios.post("/CustomersArea/CusLogReg/ForgotPassword",
                            { email: this.form.email },
                            { headers: { 'RequestVerificationToken': token } });

                        this.message = res.data.message || "重設密碼信件已寄出，請檢查信箱。";
                        this.messageColor = "green";
                    } catch (err) {
                        this.message = err.response?.data?.error || "伺服器錯誤，寄送失敗。";
                        this.messageColor = "red";
                    } finally {
                        this.sending = false;
                    }
                }
            }
        }).mount("#forgotApp");
    </script>
}
