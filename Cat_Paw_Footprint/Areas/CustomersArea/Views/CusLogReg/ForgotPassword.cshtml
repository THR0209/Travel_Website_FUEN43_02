@{
    ViewData["Title"] = "忘記密碼";
}
<div id="forgotApp" class="container mt-5" style="max-width:400px;">
    <h2 class="text-center mb-3">忘記密碼</h2>

    <form v-on:submit.prevent="sendMail" novalidate>
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label">電子郵件</label>
            <input type="email" class="form-control" v-model="form.email" required />
        </div>

        <button type="submit" class="btn btn-primary w-100" :disabled="sending">
            {{ sending ? "寄送中..." : "寄送重設信件" }}
        </button>
    </form>

    <div class="text-center mt-3">
        <span :style="{ color: messageColor }">{{ message }}</span>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script>
        const { createApp } = Vue;
        createApp({
          data() {
            return {
              sending: false,
              message: "",
              messageColor: "#555",
              form: { email: "" }
            };
          },
          methods: {
            async sendMail() {
              const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
              this.message = "";
              this.sending = true;

              try {
                const res = await axios.post(
                  "/CustomersArea/CusLogReg/ForgotPassword",
                  { email: this.form.email },
                  { headers: { 'RequestVerificationToken': token } }
                );

                this.message = res.data.message || "信件已寄出";
                this.messageColor = "green";
              } catch (err) {
                this.message = err.response?.data?.error || "伺服器錯誤，寄送失敗";
                this.messageColor = "red";
              } finally {
                this.sending = false;
              }
            }
          }
        }).mount("#forgotApp");
    </script>
}
