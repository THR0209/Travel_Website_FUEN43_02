@{
    ViewData["Title"] = "修改密碼";
}
<div class="pwd-edit-wrapper">
    <div id="editApp" class="card pwd-card fade-in-up">
        <h3 class="text-center mb-4 fw-bold text-primary">
            <i class="fa-solid fa-key me-2"></i> 修改密碼
        </h3>

        <form v-on:submit.prevent="savePwd" novalidate>
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label fw-semibold">新密碼</label>
                <input type="password" class="form-control" v-model="form.newPassword" placeholder="請輸入新密碼" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">確認新密碼</label>
                <input type="password" class="form-control" v-model="form.confirmPassword" placeholder="再次輸入新密碼" required />
            </div>

            <button type="submit" class="btn btn-primary w-100 mt-3" :disabled="saving">
                {{ saving ? "修改中..." : "確認修改" }}
            </button>
        </form>

        <div class="text-center mt-3">
            <span :style="{ color: messageColor }">{{ message }}</span>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script>
        const { createApp } = Vue;
        createApp({
          data() {
            return {
              saving: false,
              message: "",
              messageColor: "#555",
              form: { newPassword: "", confirmPassword: "" }
            };
          },
          methods: {
            async savePwd() {
              const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
              this.message = "";
              this.saving = true;

              try {
                if (this.form.newPassword !== this.form.confirmPassword) {
                  this.message = "兩次密碼不一致";
                  this.messageColor = "red";
                  return;
                }

                const res = await axios.post("/CustomersArea/CusLogReg/ChangePassword",
                  { password: this.form.newPassword },
                  { headers: { 'RequestVerificationToken': token } });

                this.message = res.data.message || "修改成功";
                this.messageColor = "green";
              } catch (err) {
                this.message = err.response?.data?.error || "伺服器錯誤";
                this.messageColor = "red";
              } finally {
                this.saving = false;
              }
            }
          }
        }).mount("#editApp");
    </script>
}