@{
    ViewData["Title"] = "重設密碼";
    var email = Context.Request.Query["email"];
    var token = Context.Request.Query["token"];
}
<div id="resetApp" class="container mt-5" style="max-width:420px;">
    <h2 class="text-center mb-4">重設密碼</h2>

    <form v-on:submit.prevent="resetPwd" novalidate>
        @Html.AntiForgeryToken()

        <input type="hidden" v-model="form.email" value="@email" />
        <input type="hidden" v-model="form.token" value="@token" />

        <div class="mb-3">
            <label class="form-label">新密碼</label>
            <input type="password" class="form-control" v-model="form.newPassword" required />
        </div>

        <div class="mb-3">
            <label class="form-label">確認新密碼</label>
            <input type="password" class="form-control" v-model="form.confirmPassword" required />
        </div>

        <button type="submit" class="btn btn-primary w-100" :disabled="saving">
            {{ saving ? "重設中..." : "重設密碼" }}
        </button>
    </form>

    <div class="text-center mt-3">
        <span :style="{ color: messageColor }">{{ message }}</span>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script>
        const { createApp } = Vue;
        createApp({
          data() {
            return {
              saving: false,
              message: "",
              messageColor: "#555",
              form: {
                email: "@email",
                token: "@token",
                newPassword: "",
                confirmPassword: ""
              }
            };
          },
          methods: {
            async resetPwd() {
              const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
              this.message = "";
              this.saving = true;

              try {
                if (this.form.newPassword !== this.form.confirmPassword) {
                  this.message = "兩次密碼不一致";
                  this.messageColor = "red";
                  return;
                }

                const res = await axios.post(
                  "/CustomersArea/CusLogReg/ResetPassword",
                  { email: this.form.email, password: this.form.newPassword },
                  { headers: { 'RequestVerificationToken': token } }
                );

                this.message = res.data.message || "重設成功";
                this.messageColor = "green";
              } catch (err) {
                this.message = err.response?.data?.error || "伺服器錯誤";
                this.messageColor = "red";
              } finally {
                this.saving = false;
              }
            }
          }
        }).mount("#resetApp");
    </script>
}