@section Styles {    
    @* 引用CSS樣式庫 *@
    <link href="~/css/travel.css" rel="stylesheet" />   

    @* 引用bootstrap的icon *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
}

@{
    ViewData["Title"] = "自由行專區";
}

<div id="app">
    <div class="row">

        <!-- 上方 - 保留凍結效果 -->
        <div class="top-buttons sticky-top bg-white shadow-sm py-3 z-3">
            <div class="container d-flex flex-wrap justify-content-between align-items-center gap-3">

                <!-- 搜尋框 -->
                <input type="text" v-model="keyword" placeholder="搜尋名稱或地區"
                       class="form-control w-25" />

                <!-- 地區篩選 -->
                <select class="form-select w-25" v-model="selectedRegion" @@change ="selectedDistrict=''">
                    <option value="">🌎 全部地區</option>
                    <option v-for="region in regions" :key="region" :value="region">{{ region }}</option>
                </select>

                <!-- 縣市篩選 -->
                <select class="form-select w-25" v-model="selectedDistrict">
                    <option value="">🏞️ 全部縣市</option>
                    <option v-for="district in availableDistricts" :key="district" :value="district">{{ district }}</option>
                </select>

                <!-- 分類按鈕 - (景點、美食、住宿) -->
                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    <button v-for="btn in buttons" :key="btn.type"
                            class="btn rounded-pill"
                            :class="{'btn-warning': currentType===btn.type, 'btn-outline-secondary': currentType!==btn.type}"
                            @@click ="changeType(btn.type)">
                        {{ btn.label }}
                    </button>
                </div>

                <!-- ⭐ 單鍵排序切換 -->
                <button class="btn"
                        :class="sortDesc ? 'btn-warning' : 'btn-outline-primary'"
                        @@click ="toggleSort">
                    ⭐ 排序：{{ sortDesc ? '高→低' : '低→高' }}
                </button>

            </div>
        </div>

        <!-- 左側顯示卡片 (動態載入區) -->
        <div class="col-md-8">
            <div class="row">
                <div v-for="(item, index) in filteredItems" :key="index" class="col-md-3 mb-4">
                    <div class="card position-relative">

                        <!-- 右上角＋鍵 -->
                        <button class="btn btn-sm btn-success position-absolute top-0 end-0 m-2"
                                @@click.stop="addToTrip(item)">
                            ＋
                        </button>

                        <!-- 點擊開啟 Modal-->
                        <div @@click="openModal(item)">                        

                            <!-- Bootstrap 輪播 -->
                            <div :id="'carousel-'+item.id" class="carousel slide" data-bs-ride="carousel">
                                <div class="carousel-inner">

                                    <!-- 判斷是否有圖片，沒有則顯示預設圖片 -->
                                    <div v-if="!item.pictureUrl || item.pictureUrl.length===0">

                                        <!-- 圖片容器(每張圖片包在 .pic 裡，保留角標) -->
                                        <div class="pic">
                                            <img src="@Url.Content("~/images/noimage.png")" class="d-block w-100" alt="圖片" />
                                        </div>
                                    </div>

                                    <!-- 有圖片則顯示輪播 -->
                                    <div v-else v-for="(pic, i) in item.pictureUrl" :key="i"
                                         class="carousel-item" :class="{'active': i===0}">

                                        <!-- 圖片容器(每張圖片包在 .pic 裡，保留角標) -->
                                        <div class="pic">
                                            <img :src="pic || '/images/noimage.png'" alt="圖片">
                                        </div>
                                    </div>

                                </div>
                            </div>
                            <div class="card-body text-center">
                                <h5 class="card-title">{{ item.name }}</h5>
                                <p>⭐ {{ item.rating }}　👁️ {{ item.views }}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 右側排行程與地圖 -->
        <div class="col-md-4">

            <!-- 排行程 -->
            <div class="card mb-3">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <span>排行程</span>
                    <!-- 🟢 新增清空按鈕 -->
                    <button class="btn btn-sm btn-danger" @@click="clearTrip">清空</button>
                </div>
                <div class="card-body">

                    <!-- 🟢 使用 vuedraggable 可拖曳排序 -->
                    <draggable v-model="tripList" item-key="uid" handle=".drag-handle" @@end ="onDragEnd">
                        <template #item="{ element, index }">
                            <div class="d-flex justify-content-between align-items-center border-bottom py-2 bg-white rounded shadow-sm my-1 px-2 ">
                                <span>
                                    <i class="bi bi-list drag-handle me-2" style="cursor: grab; font-size: 18px;"></i>
                                    {{ index + 1 }}. {{ element.name }}（{{ element.typeLabel }}）
                                </span>
                                <button class="btn btn-sm btn-outline-danger" @@click="removeFromTrip(index)">✖</button>
                            </div>
                        </template>
                    </draggable>
                    <div v-if="tripList.length === 0" class="text-muted text-center ">
                        尚未加入任何行程
                    </div>

                    <!-- 🟢 儲存行程 -->
                    <button v-if="tripList.length > 0" class="btn btn-success w-100 mt-3" @@click="saveTrip">
                        💾 儲存行程
                    </button>
                </div>
            </div>

            <!-- 行程地圖 -->
            <div class="card">
                <div class="card-header bg-success text-white">行程地圖</div>
                <div class="card-body">
                    <p>這裡未來可以整合 Google Maps。</p>
                </div>
            </div>
        </div>

    </div>

    <!-- 詳細內容 Modal（點圖片顯示詳情）-->
    <div class="modal fade" id="detailModal" tabindex="-1" aria-labelledby="detailModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="detailModalLabel">{{ modalData.name }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p><strong>📍 地址：</strong>{{ modalData.addr }}</p>                    
                    <p class="mt-3">{{ modalData.desc }}</p>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts{    
    <script src="https://unpkg.com/vue@3.5.22/dist/vue.global.js"></script>

    <!-- 支援拖曳排序 -->
    <script src="https://unpkg.com/sortablejs@1.15.0/Sortable.min.js"></script>
    <script src="https://unpkg.com/vuedraggable@4.0.1/dist/vuedraggable.umd.min.js"></script>

    <!-- Google Key -->
    <script async defer
            src="https://maps.googleapis.com/maps/api/js?key=@ViewBag.GoogleMapKey&libraries=places">
    </script>

    <script>
        const { createApp } = Vue;

        const app = createApp({

            // CDN 模式需使用 window.vuedraggable
            components: { draggable: window.vuedraggable },

            data() {
                return {
                    buttons: [
                        { label: "景點", type: "locations" },
                        { label: "美食", type: "restaurants" },
                        { label: "住宿", type: "hotels" }
                    ],
                    currentType: "locations",
                    items: [],
                    keyword: "",       // 搜尋關鍵字
                    modalData: {},     // Modal 詳情資料
                    sortDesc: true ,    // 排序狀態（true = 高→低）

                    /* 地區 / 縣市綁定欄位 */
                    selectedRegion: "離島",   // 預設地區
                    selectedDistrict: "",     // 預設不選縣市
                    regions: ["北部", "中部", "南部", "東部", "離島"],
                    districtsByRegion: {
                        "北部": ["台北市", "新北市", "基隆市", "桃園市", "新竹縣", "新竹市", "宜蘭縣"],
                        "中部": ["苗栗縣", "台中市", "彰化縣", "南投縣", "雲林縣"],
                        "南部": ["嘉義縣", "嘉義市", "台南市", "高雄市", "屏東縣"],
                        "東部": ["台東縣", "花蓮縣"],
                        "離島": ["澎湖", "金門", "馬祖", "綠島", "蘭嶼", "小琉球"]
                    },
                    tripList: [],    // 行程清單
                    currentUser: null,  // 目前登入使用者資訊
                }
            },

            computed: {
                /* 根據選擇的地區動態顯示縣市 */
                availableDistricts() {
                    return this.selectedRegion
                        ? this.districtsByRegion[this.selectedRegion]
                        : Object.values(this.districtsByRegion).flat();
                },

                /* 綜合搜尋 + 篩選功能 */
                filteredItems() {
                    const key = this.keyword.toLowerCase();
                    return this.items.filter(x => {
                        const matchKeyword =
                            !this.keyword ||
                            (x.name && x.name.toLowerCase().includes(key)) ||
                            (x.regionName && x.regionName.toLowerCase().includes(key)) ||
                            (x.districtName && x.districtName.toLowerCase().includes(key));

                        const matchRegion =
                            !this.selectedRegion || x.regionName === this.selectedRegion;

                        const matchDistrict =
                            !this.selectedDistrict || x.districtName === this.selectedDistrict;

                        return matchKeyword && matchRegion && matchDistrict;
                    });
                }
            },

            methods: {
                /* 取得目前登入者資訊 */
                async getCurrentUser() {
                    try {
                        const res = await fetch('/api/currentUser', {
                        credentials: 'include'   // ✅ 加上這行
                        });
                        if (!res.ok) throw new Error('尚未登入');
                        const data = await res.json();
                        console.log("👤 目前登入者：", data);
                        this.currentUser = data;
                    } catch (err) {
                        console.warn("⚠️ 無法取得登入者資訊", err);
                        this.currentUser = null;
                    }
                },

                // 改變分類 (景點/美食/住宿)
                async changeType(type) {
                    this.currentType = type;
                    await this.fetchData();
                },

                // 取得資料 (Ajax 呼叫 Controller)
                async fetchData() {
                    const res = await fetch(`/api/${this.currentType}`, {
                        headers: {
                            "X-Requested-With": "XMLHttpRequest" // 識別為 Ajax 呼叫
                        }
                    });
                    const json = await res.json();

                    // 後端 JSON 轉換成前端使用格式
                    this.items = json.map(x => ({
                        id: x.hotelID || x.locationID || x.restaurantID,
                        name: x.hotelName || x.locationName || x.restaurantName,
                        addr: x.hotelAddr || x.locationAddr || x.restaurantAddr,     
                        desc: x.hotelDesc || x.locationDesc || x.restaurantDesc,     
                        regionName: x.regionName,
                        districtName: x.districtName,
                        rating: x.rating,
                        views: x.views,
                        pictureUrl: x.pictureUrl || []
                    }));
                },

                // 單鍵切換排序方向 - 評分排序（高→低) <-> (低→高）
                toggleSort() {
                    this.sortDesc = !this.sortDesc; // 切換狀態
                    if (this.sortDesc) {
                        this.items.sort((a, b) => (b.rating || 0) - (a.rating || 0));
                    } else {
                        this.items.sort((a, b) => (a.rating || 0) - (b.rating || 0));
                    }
                },

                // Modal 顯示
                openModal(item) {
                    this.modalData = item;
                    const modal = new bootstrap.Modal(document.getElementById('detailModal'));
                    modal.show();
                },

                /* 加入行程 */
                addToTrip(item) {
                    // 檢查是否已存在相同項目 (同分類同 id 不可重複)
                    const exists = this.tripList.some(
                        x => x.id === item.id && x.type === this.currentType
                    );
                    if (!exists) {
                        this.tripList.push({
                            uid: `${this.currentType}-${item.id}`, // 唯一 key
                            id: item.id,
                            name: item.name,
                            type: this.currentType,
                            typeLabel: this.buttons.find(b => b.type === this.currentType).label
                        });
                    }else {
                        alert(`❗「${item.name}」已在行程中！`);
                    }
                },

                /* 刪除單一行程 */
                removeFromTrip(index) {
                    this.tripList.splice(index, 1);
                },

                /* 清空行程 */
                clearTrip() {
                    // 若沒有行程 → 提示並離開
                    if (this.tripList.length === 0) {
                        alert("目前沒有任何行程可以清空！");
                        return;
                    }

                    // confirm() 對話框，讓使用者選擇
                    const result = confirm("❓確定要清空所有行程嗎？\n（按「取消」可保留目前行程）");

                    // 按下「確定」→ 清空行程
                    if (result) {
                        
                        this.tripList.splice(0, this.tripList.length);                        
                    } 
                },

                /* 拖曳完成事件（可選，顯示目前排序） */
                onDragEnd() {
                    console.log("🔁 已重新排序：", this.tripList.map(x => x.name).join(" → "));
                    // 重新觸發 Vue 更新畫面（防止 index 顯示未更新）
                    this.tripList = [...this.tripList];
                },

                /* 儲存行程 */
                async saveTrip() {
                    if (!this.currentUser) {
                        alert("⚠️ 尚未登入，無法儲存行程！");
                        return;
                    }

                    const payload = {
                        customerId: this.currentUser.customerId, // 改登入者ID
                        projectName: "我的自由行",
                        tripDetails: this.tripList.map((item, idx) => ({
                            tripSequence: idx + 1,  // 排序順序
                            tripType: item.typeLabel,   // 類別名稱（景點、美食、住宿）
                            tripTargetID: item.id,  // 對應原始資料 ID
                            tripName: item.name     // 方便前端檢查（純顯示用）
                        }))
                    };

                    // 這一行 — 讓你能在 Console 看送出的內容
                    console.log("🚀 送出行程資料：", payload);

                    // const res = await fetch('/Travel/SaveTrip', {
                    //     method: 'POST',
                    //     headers: { 'Content-Type': 'application/json' },
                    //     body: JSON.stringify(payload)
                    // });
                    // if (res.ok) alert('✅ 行程已儲存！');
                }
            },            

            mounted() {
                // 預設載入
                this.fetchData().then(() => {
                    // 資料載入後，保持離島預設狀態
                    this.selectedRegion = "離島";
                });

                // 初始化抓取登入者
                this.getCurrentUser(); 

                // 🧩 重新啟用所有 dropdown 功能
                const dropdownList = document.querySelectorAll('[data-bs-toggle="dropdown"]');
                dropdownList.forEach((dropdownToggleEl) => {
                    new bootstrap.Dropdown(dropdownToggleEl);
                });
            }
        });
        // 全域註冊 draggable
        app.component('draggable', vuedraggable); 
        app.mount("#app");
    </script>
}

