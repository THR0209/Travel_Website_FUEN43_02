@{
    ViewData["Title"] = "優惠活動詳情";
}

<section class="section py-5" id="promotion-detail" v-cloak>
    <div class="container">
        <!-- 載入成功 -->
        <div v-if="promotion" class="card shadow-sm border-0 rounded-4">
            <img :src="promotion.coverImage || '/images/NoImage.png'"
                 :alt="promotion.promoName"
                 class="card-img-top"
                 style="object-fit: cover; height: 500px; border-radius: 6px;">

            <div class="card-body p-4 text-center">
                <h2 class="fw-bold mb-3 text-brand">{{ promotion.promoName }}</h2>

                <p class="text-muted mb-2">
                    <i class="fa-regular fa-calendar me-1"></i>
                    {{ formatDate(promotion.startTime) }} ~ {{ formatDate(promotion.endTime) }}
                </p>

                <p class="badge bg-warning text-dark px-3 py-2">{{ promotion.promoSummary }}</p>

                <!-- ✅ 優惠活動描述（CKEditor HTML） -->
                <div class="promo-desc text-start mt-4" v-html="promotion.promoDesc"></div>

                <!-- 🔹 限時優惠倒數區 -->
                <div class="countdown-wrapper mt-4">
                    <div v-if="timeRemaining.totalMs > 0">
                        <div class="fw-bold mb-1">
                            距離結束還有：
                            <span class="text-danger">
                                {{ timeRemaining.days }} 天
                                {{ timeRemaining.hours }} 小時
                                {{ timeRemaining.minutes }} 分鐘
                            </span>
                        </div>
                        <div class="progress countdown-bar">
                            <div class="progress-bar bg-gradient" role="progressbar"
                                 :style="{ width: progressWidth + '%' }"></div>
                        </div>
                    </div>
                    <div v-else class="text-muted small">
                        活動已結束
                    </div>
                </div>

                <!-- 🔸 綁定產品 -->
                <div v-if="promotion.products && promotion.products.length" class="mt-5">
                    <h4 class="fw-bold mb-3 text-brand">優惠商品</h4>
                    <div class="row g-3 justify-content-center">
                        <div v-for="prod in promotion.products" :key="prod.productID" class="col-12 col-sm-6 col-md-4 col-lg-3">
                            <div class="card h-100 border-0 shadow-sm">
                                <img :src="prod.productImageUrl || '/images/NoImage.png'"
                                     :alt="prod.productName"
                                     class="card-img-top"
                                     style="height:160px;object-fit:cover;">
                                <div class="card-body text-center">
                                    <h6 class="fw-bold text-truncate">{{ prod.productName }}</h6>
                                    <p class="text-muted mb-1">NT$ {{ prod.productPrice?.toLocaleString() }}</p>
                                    <a :href="'/CustomersArea/Products/Details/' + prod.productID"
                                       class="btn btn-outline-primary btn-sm rounded-pill mt-1">查看商品</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 🔸 返回按鈕 -->
                <div class="mt-5">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">
                        返回首頁
                    </a>
                    <a asp-action="Index" class="btn btn-outline-primary rounded-pill px-4 ms-2">
                        返回列表
                    </a>
                </div>
            </div>
        </div>

        <!-- 無資料 -->
        <div v-else class="text-center py-5 text-muted">
            <i class="fa-regular fa-face-frown" style="font-size:2rem;"></i>
            <p class="mt-2 mb-0">找不到指定的優惠活動</p>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

    <script>
        const app = Vue.createApp({
            data() {
                return {
                    promotion: null,
                    timeRemaining: { days: 0, hours: 0, minutes: 0, totalMs: 0 },
                    progressWidth: 0,
                    timer: null
                };
            },
            methods: {
                formatDate(dateStr) {
                    if (!dateStr) return '';
                    const date = new Date(dateStr);
                    return isNaN(date) ? '' : date.toLocaleDateString('zh-TW');
                },
                updateCountdown() {
                    if (!this.promotion?.endTime || !this.promotion?.startTime) return;

                    const now = new Date();
                    const end = new Date(this.promotion.endTime);
                    const start = new Date(this.promotion.startTime);
                    const total = end - start;
                    const remaining = end - now;

                    if (remaining <= 0) {
                        this.timeRemaining = { days: 0, hours: 0, minutes: 0, totalMs: 0 };
                        this.progressWidth = 100;
                        clearInterval(this.timer);
                        return;
                    }

                    const days = Math.floor(remaining / (1000 * 60 * 60 * 24));
                    const hours = Math.floor((remaining / (1000 * 60 * 60)) % 24);
                    const minutes = Math.floor((remaining / (1000 * 60)) % 60);

                    this.timeRemaining = { days, hours, minutes, totalMs: remaining };
                    const progress = 100 - (remaining / total) * 100;
                    this.progressWidth = Math.min(100, Math.max(0, progress));
                }
            },
            mounted() {
                const id = window.location.pathname.split('/').pop();
                axios.get(`/CustomersArea/Promotions/GetById/${id}`)
                    .then(res => {
                        this.promotion = res.data;
                        this.updateCountdown();
                        this.timer = setInterval(this.updateCountdown, 60000); // 每分鐘更新
                    })
                    .catch(err => console.error('載入優惠活動失敗：', err));
            },
            beforeUnmount() {
                clearInterval(this.timer);
            }
        });

        app.mount('#promotion-detail');
    </script>
}
