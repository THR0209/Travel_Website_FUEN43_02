@{
    ViewData["Title"] = "優惠活動";
}

<div id="promotion-list" class="promotion-wrapper container py-5" v-cloak>
    <h2 class="text-center mb-5 fw-bold text-brand">
        <i class="fa-solid fa-bullhorn me-2"></i> 優惠活動
    </h2>

    <!-- 有資料 -->
    <div v-if="promotions.length > 0" class="row g-3 g-md-4 justify-content-center">
        <div v-for="p in promotions" :key="p.promoID" class="col-12 col-sm-6 col-lg-3">
            <a :href="'/CustomersArea/Promotions/Details/' + p.promoID" class="text-decoration-none text-dark">
                <div class="card promo-card shadow-sm h-100 border-0">
                    <div class="promo-thumb">
                        <img :src="p.imageUrl || '/images/NoImage.png'"
                             :alt="p.promoName"
                             class="card-img-top">
                        <div class="promo-overlay">
                            <span class="promo-more">查看活動</span>
                        </div>
                    </div>
                    <div class="card-body">
                        <h6 class="fw-bold text-brand mb-1 text-truncate">{{ p.promoName }}</h6>
                        <p class="text-muted small mb-1">
                            <i class="fa-regular fa-calendar me-1"></i>
                            {{ formatDate(p.startTime) }} ~ {{ formatDate(p.endTime) }}
                        </p>
                        <p class="small text-secondary mb-0 line-clamp-2">{{ p.promoDesc }}</p>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- 無資料 -->
    <div v-else class="text-center text-muted py-5">
        <i class="fa-solid fa-paw mb-3" style="font-size:2rem; color:#7ec8e3;"></i>
        <p class="mb-0">目前沒有可顯示的優惠活動 💤</p>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

    <script>
        const app = Vue.createApp({
            data() {
                return { promotions: [] }
            },
            methods: {
                formatDate(dateStr) {
                    if (!dateStr) return ''
                    const date = new Date(dateStr)
                    return isNaN(date) ? '' : date.toLocaleDateString('zh-TW')
                }
            },
            mounted() {
                axios.get('/CustomersArea/Promotions/GetAllActivePromotions')
                    .then(res => {
                        this.promotions = res.data || []
                        console.log('載入優惠活動成功：', this.promotions)
                    })
                    .catch(err => console.error('載入優惠活動失敗：', err))
            }
        })

        app.mount('#promotion-list')
    </script>
}

