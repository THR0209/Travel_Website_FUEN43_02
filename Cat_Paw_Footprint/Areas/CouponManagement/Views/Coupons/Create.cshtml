@model Cat_Paw_Footprint.Areas.CouponManagement.ViewModel.CouponViewModel

@{
    ViewData["Title"] = "新增優惠券";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-sm rounded-3">
                <div class="card-header bg-primary text-white fw-bold">
                    <i class="fa-solid fa-ticket me-2"></i> 新增優惠券
                    <button type="button" class="btn btn-outline-success" id="btnFillExample" title="一鍵填入範例">
                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                    </button>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        @* <div class="mb-3 mt-3">
                            <label asp-for="CouponCode" class="form-label fw-semibold"></label>
                            <input asp-for="CouponCode" class="form-control" placeholder="輸入流水號" />
                            <span asp-validation-for="CouponCode" class="text-danger"></span>
                        </div> *@

                        <div class="mb-3 mt-3">
                            <label asp-for="CouponName" class="form-label fw-semibold"></label>
                            <input asp-for="CouponName" class="form-control" placeholder="輸入優惠券名稱" />
                            <span asp-validation-for="CouponName" class="text-danger"></span>
                        </div>

                        <div class="mb-3 mt-3">
                            <label asp-for="DiscountCode" class="form-label fw-semibold"></label>
                            <input asp-for="DiscountCode" class="form-control" placeholder="輸入優惠券折扣代碼" />
                            <span asp-validation-for="DiscountCode" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CouponDesc" class="form-label fw-semibold"></label>
                            <input asp-for="CouponDesc" class="form-control" placeholder="輸入優惠券描述" />
                            <span asp-validation-for="CouponDesc" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DiscountType" class="form-label fw-semibold"></label>
                            <select asp-for="DiscountType" class="form-select">
                                <option value="1">百分比折扣 (%)</option>
                                <option value="2">固定金額折扣 ($)</option>
                            </select>
                            <span asp-validation-for="DiscountType" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DiscountValue" class="form-label fw-semibold"></label>
                            <input asp-for="DiscountValue" class="form-control" placeholder="輸入折扣值" />
                            <span asp-validation-for="DiscountValue" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MinimumAmount" class="form-label fw-semibold"></label>
                            <input asp-for="MinimumAmount" class="form-control" placeholder="滿額門檻" />
                            <span asp-validation-for="MinimumAmount" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MaximumDiscount" class="form-label fw-semibold"></label>
                            <input asp-for="MaximumDiscount" class="form-control" placeholder="最大折抵" />
                            <span asp-validation-for="MaximumDiscount" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="StartDate" class="form-label fw-semibold"></label>
                            <input asp-for="StartDate" class="form-control" type="date" />
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EndDate" class="form-label fw-semibold"></label>
                            <input asp-for="EndDate" class="form-control" type="date" />
                            <span asp-validation-for="EndDate" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="TargetType" class="form-label"></label>
                            <select asp-for="TargetType" class="form-select">
                                <option value="All">全體會員</option>
                                <option value="Register">新註冊會員</option>
                                <option value="Level_Bronze">銅級會員</option>
                                <option value="Level_Silver">銀級會員</option>
                                <option value="Level_Gold">金級會員</option>
                            </select>
                            <span asp-validation-for="TargetType" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="AutoGrantType">自動發放時機</label>
                            <select asp-for="AutoGrantType" class="form-select">
                                <option value="">(不自動發放)</option>
                                <option value="Register">新會員註冊</option>
                                <option value="LevelUp">會員升級</option>
                                <option value="Birthday">會員生日</option>
                                <option value="Festival">節慶活動</option>
                            </select>
                            <small class="form-text text-muted">
                                若不設定，系統不會自動發放此優惠券。
                            </small>
                        </div>
                        

                        <div class="form-group mb-3">
                            <label asp-for="ValidDays" class="form-label"></label>
                            <input asp-for="ValidDays" class="form-control" placeholder="例如：14（代表領券後14天內可用）" />
                            <span asp-validation-for="ValidDays" class="text-danger"></span>
                        </div>


                        <div class="mb-3 form-check">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label fw-semibold"></label>
                            <span asp-validation-for="IsActive" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fa-solid fa-arrow-left"></i> 返回清單
                            </a>
                            <button type="submit" class="btn btn-outline-primary">
                                <i class="fa-solid fa-plus"></i> 建立
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.getElementById("btnFillExample").addEventListener("click", function () {
            document.getElementById("CouponName").value = "聖誕節優惠";
            document.getElementById("DiscountCode").value = "Chrismas2025";
            document.getElementById("CouponDesc").value = "聖誕節優惠活動，滿千折百。";

            // 折扣方式 → 固定金額折扣
            document.getElementById("DiscountType").value = "2";

            document.getElementById("DiscountValue").value = "100";
            document.getElementById("MinimumAmount").value = "1000";

            // 折扣上限留空
            document.getElementById("MaximumDiscount").value = "";

            // 可選：清空日期
            document.getElementById("StartDate").value = "2025-12-25";
            document.getElementById("EndDate").value = "2025-12-31";

            // TargetType & 自動發放時機 不強制設定
            // document.getElementById("TargetType").value = "All";
            // document.getElementById("AutoGrantType").value = "";

            // 預設可用天數留空
            document.getElementById("ValidDays").value = "";

            // 啟用
            document.getElementById("IsActive").checked = true;
        });
    </script>

}
